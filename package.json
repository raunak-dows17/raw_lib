{
  "name": "raw_lib",
  "version": "2.0.0",
  "description": "Modular, adapter-driven query, validation and authentication toolkit for Node.js",
  "license": "MIT",
  "author": "Raunak Pandey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raunak-dows17/raw_lib.git"
  },
  "homepage": "https://github.com/raunak-dows17/raw_lib#readme",
  "bugs": {
    "url": "https://github.com/raunak-dows17/raw_lib/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mongo": {
      "types": "./dist/mongo/index.d.ts",
      "import": "./dist/mongo/index.js",
      "require": "./dist/mongo/index.cjs"
    },
    "./val": {
      "types": "./dist/val/index.d.ts",
      "import": "./dist/val/index.js",
      "require": "./dist/val/index.cjs"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "npm run build && node scripts/smoke-package.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run build",
    "release:next": "npm publish --tag next --access public --provenance"
  },
  "peerDependencies": {
    "mongodb": ">=6"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "mongodb": "^7.9.1",
    "mongodb-memory-server": "^11.4.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "keywords": [
    "rawql",
    "rawlib",
    "query-engine",
    "validation",
    "authentication",
    "clean-architecture",
    "adapter",
    "typescript"
  ]
}
